{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleDetection": "legacy",
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": false
  },
  "include": ["src/parts/*.ts", "src/core/*.ts", "src/globals.d.ts"]
}
